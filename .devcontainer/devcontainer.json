{
  "name": "gravelio",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=gravelio-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gravelio-opencode-config-${devcontainerId},target=/home/vscode/.config/opencode,type=volume",
    "source=gravelio-opencode-data-${devcontainerId},target=/home/vscode/.local/share/opencode,type=volume",
    "source=gravelio-pnpm-${devcontainerId},target=/home/vscode/.local/share/pnpm,type=volume",
    "source=gravelio-nuget-${devcontainerId},target=/home/vscode/.nuget,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "PNPM_HOME": "/home/vscode/.local/share/pnpm"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/share/pnpm:/home/vscode/.dotnet/tools"
  },
  "forwardPorts": [4200, 5129, 8080],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "angular.ng-template",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
