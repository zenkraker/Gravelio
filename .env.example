# Both are required; Compose refuses to start while they are empty.
DB_PASSWORD=
# Password of the first admin user ("admin"), 12+ characters. Only used while the database has no users.
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Set to false only for plain-http trials.
SECURE_COOKIES=true
PORT=8080

# Per-IP login attempts per minute (default 10). Raise it for automated e2e runs.
LOGIN_ATTEMPTS_PER_MINUTE=10

# Requests per minute per user (per IP when signed out): reads, writes (POST/PUT/DELETE) and file uploads.
RATE_LIMIT_READS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_MINUTE=20
